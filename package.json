{
  "name": "arlas-web-contributors",
  "version": "28.1.0-dev0",
  "description": "Contributors Library for ARLAS Components",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "scripts": {
    "build-release-watch": "tsc -p tsconfig.json --watch && npm run copy-root-schema && npm run copy-npm-readme",
    "build-release": "tsc -p tsconfig.json && tsc-alias && npm run copy-root-schema && npm run copy-npm-readme",
    "clean": "npm cache clear && rimraf -- dist",
    "lint": "eslint . --ext .ts",
    "copy-root-schema": "cp src/jsonSchemas/rootContributorConf.schema.json dist/jsonSchemas",
    "copy-npm-readme": "cp README-NPM.md dist/README.md",
    "license-check": "license-check-and-add check -f license-check-and-add.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gisaia/ARLAS-web-contributors.git"
  },
  "author": "gisaia",
  "license": "Apache-2.0",
  "dependencies": {
    "@turf/bbox": "^7.3.0",
    "@turf/bbox-polygon": "^7.3.0",
    "@turf/boolean-contains": "^7.3.0",
    "@types/file-saver": "^2.0.1",
    "@types/jsonpath": "^0.2.0",
    "@types/tinycolor2": "^1.4.0",
    "arlas-web-core": "28.0.0-rc.2",
    "betterknown": "^1.2.0",
    "file-saver": "^2.0.2",
    "jsonpath": "^1.0.0",
    "moment": "^2.29.4",
    "ngeohash": "^0.6.0",
    "rxjs": "^7.4.0",
    "tinycolor2": "~1.4.1"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.6.1",
    "@types/ngeohash": "^0.6.8",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "license-check-and-add": "^4.0.5",
    "node": "^24.10.1",
    "tsc-alias": "^1.8.16",
    "typescript": "~5.9.3"
  },
  "bugs": {
    "url": "https://github.com/gisaia/ARLAS-web-contributors/issues"
  },
  "homepage": "https://github.com/gisaia/ARLAS-web-contributors/blob/master/README.md",
  "overrides": {
    "underscore": "^1.13.8"
  }
}
